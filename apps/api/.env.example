# Copy to .env and fill in. Never commit real keys.

# Server-side only. The browser gets short-lived streaming tokens instead.
ASSEMBLYAI_API_KEY=

# Reasoning models on the AssemblyAI LLM Gateway. The gateway isn't part of the free plan:
# free credits cover speech-to-text only, so add a payment method in the AssemblyAI dashboard
# first. Structured outputs need a model that supports them (Claude 4.5 or later).
# Grounded answers:
ASSEMBLYAI_LLM_MODEL=claude-sonnet-4-6
# Translation + question detection, which runs on every finished turn. Keep it fast.
# Leave it empty to use ASSEMBLYAI_LLM_MODEL for both.
ASSEMBLYAI_LLM_FAST_MODEL=claude-haiku-4-5

# Comma-separated origins allowed for HTTP (CORS) and the WebSocket.
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# STREAMING_TOKEN_TTL_SECONDS=60
# STREAMING_MAX_SESSION_SECONDS=3600
# STREAMING_TOKENS_PER_SESSION=30
# LLM_TIMEOUT_SECONDS=15
# MAX_UPLOAD_BYTES=10485760
