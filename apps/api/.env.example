# Copy to .env and fill in. Never commit real keys.

# Speech-to-text always runs on AssemblyAI. Server-side only: the browser gets short-lived
# streaming tokens. Free AssemblyAI credits cover streaming (Universal-3.5 Pro included).
ASSEMBLYAI_API_KEY=

# Translation, question detection, and answers: pick one LLM provider.
#   groq        Groq, free key without a card at console.groq.com: about 30 requests/min
#               and 1,000/day per model. Fast, which suits live translation.
#   openrouter  OpenRouter: ':free' models allow 20 requests/min and 50/day in total
#               (1,000/day after a one-time $10 credit purchase)
#   gemini      Google Gemini API, free key at aistudio.google.com
#   openai      OpenAI
#   custom      any other OpenAI-compatible API (set LLM_BASE_URL)
#   assemblyai  AssemblyAI LLM Gateway on ASSEMBLYAI_API_KEY (paid AssemblyAI accounts only)
# Each finished turn is one request, plus one per answered question.
LLM_PROVIDER=groq
# The key for that provider (not used for assemblyai).
LLM_API_KEY=
# Model for answers, and a faster one for per-turn translation + question detection
# (empty = LLM_MODEL). `uv run python -m scripts.smoke_assemblyai` lists the models your key
# can use. If translations read poorly, set LLM_FAST_MODEL to the answer model.
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# Reasoning models (gpt-oss, Gemini 2.5, OpenAI o-series/GPT-5): "low" answers faster and
# uses less of a free tier's tokens-per-minute budget. Empty = the provider's default.
# Not sent to OpenRouter.
LLM_REASONING_EFFORT=low
# Required for LLM_PROVIDER=custom (e.g. http://localhost:11434/v1 for Ollama); for the
# providers above it replaces their default URL.
# LLM_BASE_URL=

# Other setups:
#   OpenRouter: LLM_PROVIDER=openrouter  LLM_MODEL=openrouter/free  LLM_FAST_MODEL=
#     openrouter/free picks any free model that is up; a fixed ':free' model from the
#     smoke test's list gives steadier translations. Free model ids change over time.
#   Gemini: LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.5-flash  LLM_FAST_MODEL=gemini-2.5-flash-lite
#     LLM_REASONING_EFFORT=  (empty: Flash-Lite doesn't think unless asked to)
#   AssemblyAI LLM Gateway: LLM_PROVIDER=assemblyai, then optionally
#     ASSEMBLYAI_LLM_MODEL=claude-sonnet-4-6 and ASSEMBLYAI_LLM_FAST_MODEL=claude-haiku-4-5

# Semantic search (embeddings), fused with keyword search over your documents and, with
# DATABASE_URL, over saved sessions: a question in Indonesian finds an English passage.
# Groq and OpenRouter have no embeddings, so point this at Gemini's free tier with its own
# key (aistudio.google.com). Empty EMBEDDING_PROVIDER follows LLM_PROVIDER when that is
# gemini or openai; "none" turns it off (keyword search only).
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
# Defaults: gemini-embedding-001 (gemini), text-embedding-3-small (openai).
# EMBEDDING_MODEL=
# Optional: shorter vectors (e.g. 768) for gemini-embedding-001 or text-embedding-3-*.
# EMBEDDING_DIMENSIONS=
# Required for EMBEDDING_PROVIDER=custom (any OpenAI-compatible /embeddings API).
# EMBEDDING_BASE_URL=
# Cosine similarity a passage needs before an answer may cite it.
# RETRIEVAL_MIN_SIMILARITY=0.5

# Meeting history: finished sessions saved to Postgres with pgvector, listed at /history and
# searchable by meaning. Empty = off (live sessions work without it). Supabase: Project
# Settings → Database → Connection string → "Session pooler" (port 5432). The API creates
# its own `contexa` schema, with row level security on, the first time it connects.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# With sign-in on the web app: the same Supabase project URL and publishable (anon) key as
# NEXT_PUBLIC_SUPABASE_*, so signed-in users' sessions follow their account. Without them,
# sessions belong to the browser that saved them.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=

# Documents from links (web pages, PDFs, GitHub repositories). Optional: a GitHub token
# (no scopes needed for public repos) raises GitHub's limit from 60 downloads an hour and
# allows private repositories.
# GITHUB_TOKEN=
# MAX_IMPORT_BYTES=5242880
# MAX_REPO_DOWNLOAD_BYTES=31457280

# Comma-separated origins allowed for HTTP (CORS) and the WebSocket.
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# STREAMING_TOKEN_TTL_SECONDS=60
# STREAMING_MAX_SESSION_SECONDS=3600
# STREAMING_TOKENS_PER_SESSION=30
# LLM_TIMEOUT_SECONDS=15
# MAX_UPLOAD_BYTES=10485760
