# Copy to .env and fill in. Never commit real keys.

# Speech-to-text always runs on AssemblyAI. Server-side only: the browser gets short-lived
# streaming tokens. Free AssemblyAI credits cover streaming (Universal-3.5 Pro included).
ASSEMBLYAI_API_KEY=

# Translation, question detection, and answers: pick one LLM provider.
#   assemblyai  AssemblyAI LLM Gateway, uses ASSEMBLYAI_API_KEY (needs a paid AssemblyAI account)
#   openrouter  OpenRouter; ':free' models allow 20 requests/min and 50/day (1,000/day after
#               a one-time $10 credit purchase)
#   groq        Groq; free tier around 30 requests/min and 1,000/day
#   gemini      Google Gemini API; free tier with a Google AI Studio key
#   openai      OpenAI
#   custom      any other OpenAI-compatible API (set LLM_BASE_URL)
# Each finished turn is one request, plus one per answered question.
LLM_PROVIDER=openrouter
# The key for that provider (not used for assemblyai).
LLM_API_KEY=
# Model for answers, and a faster one for per-turn translation + question detection
# (empty = LLM_MODEL). `uv run python -m scripts.smoke_assemblyai` lists the models your key
# can use. OpenRouter's ':free' models rotate: openrouter/free routes to one that is up,
# but a fixed model from that list gives steadier translations.
LLM_MODEL=openrouter/free
LLM_FAST_MODEL=
# Only for LLM_PROVIDER=custom, e.g. http://localhost:11434/v1
# LLM_BASE_URL=

# Other setups:
#   Groq:   LLM_PROVIDER=groq    LLM_MODEL=openai/gpt-oss-120b  LLM_FAST_MODEL=openai/gpt-oss-20b
#   Gemini: LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.5-flash      LLM_FAST_MODEL=gemini-2.5-flash-lite
#   AssemblyAI LLM Gateway: LLM_PROVIDER=assemblyai, then optionally
#     ASSEMBLYAI_LLM_MODEL=claude-sonnet-4-6 and ASSEMBLYAI_LLM_FAST_MODEL=claude-haiku-4-5

# Comma-separated origins allowed for HTTP (CORS) and the WebSocket.
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# STREAMING_TOKEN_TTL_SECONDS=60
# STREAMING_MAX_SESSION_SECONDS=3600
# STREAMING_TOKENS_PER_SESSION=30
# LLM_TIMEOUT_SECONDS=15
# MAX_UPLOAD_BYTES=10485760
