# Copy to .env.local. Leave these empty to run without sign-in: the app works,
# the header hides "Sign in", and the auth pages explain what to configure.

# Supabase Auth (Google + email/password). Both values are public by design.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key works too.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public URL for auth email links and OAuth redirects. Defaults to the
# request origin. Set it in production, and allow-list <url>/auth/callback in Supabase.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
