# Copy to .env.local.

# The Contexa API (apps/api). When set, /session runs the live AssemblyAI pipeline;
# when empty, it runs the scripted UI preview. Inlined at build time, so production
# needs a rebuild after changing it. The API's CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave these empty to run without sign-in: the app works,
# the header hides "Sign in", and the auth pages explain what to configure.

# Supabase Auth (Google + email/password). Both values are public by design.
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key works too.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: public URL for auth email links and OAuth redirects. Defaults to the
# request origin. Set it in production, and allow-list <url>/auth/callback in Supabase.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
